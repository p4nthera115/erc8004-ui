{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/docs/components/:slug",
      "has": [
        { "type": "header", "key": "accept", "value": ".*text/markdown.*" }
      ],
      "destination": "/llms/:slug.md"
    },
    {
      "source": "/docs/:slug",
      "has": [
        { "type": "header", "key": "accept", "value": ".*text/markdown.*" }
      ],
      "destination": "/llms/_guides/:slug.md"
    },
    {
      "source": "/docs",
      "has": [
        { "type": "header", "key": "accept", "value": ".*text/markdown.*" }
      ],
      "destination": "/llms.txt"
    },
    {
      "source": "/docs/components/:slug.md",
      "destination": "/llms/:slug.md"
    },
    {
      "source": "/docs/:slug.md",
      "destination": "/llms/_guides/:slug.md"
    },
    { "source": "/docs.md", "destination": "/llms.txt" }
  ],
  "headers": [
    {
      "source": "/(llms.txt|llms-full.txt)",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=600"
        },
        { "key": "X-Robots-Tag", "value": "all" }
      ]
    },
    {
      "source": "/llms/(.*).md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=600"
        },
        { "key": "X-Robots-Tag", "value": "all" }
      ]
    }
  ]
}
